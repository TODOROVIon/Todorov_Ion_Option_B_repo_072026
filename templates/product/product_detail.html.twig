{% extends 'base.html.twig' %}

{% block title %}Produit Details{% endblock %}

{% block body %}
    <section class="product-detail-container">
        <div class="product-detail-content">

            <div class="product-detail-image">    
                <img src="{{ asset('/img/produits/' ~  product.picture )}}" alt="Image produit detail">
            </div>

            <div class="product-detail-text">
                <h2>{{ product.name }}</h2>
                <h1 class="price-prod-id">{{ product.Price|number_format(2, ',', ' ')  }} €</h1>
                <p>Description</p>
                <h3>{{ product.fullDescription }}</h3>
                <a class="ajout-panier" href="{{ path('app_panier_add', {id: product.id}) }}">Ajouter au panier</a>
            </div>

        </div>
    </section>

    

{% endblock %}
