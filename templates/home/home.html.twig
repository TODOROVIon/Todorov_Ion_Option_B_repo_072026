{% extends 'base.html.twig' %}

{% block title %}Bienvenue - GreenGoodies{% endblock %}

{% block body %}
    <section class="home-container">
        <div class="home-content">
            <div class="home-text">
                <h1>Bienvenue</h1>
                <br>
                <p>Découvrez notre univers de produits durables et éthiques pour une consommation responsable</p>
                <br>
                <p>Retrouvez des articles d’hygiène & beauté, des accessoires & boissons et du prêt 
                à porter</p>
            </div>
            <div class="home-image">    
                <img src="{{ asset('/img/Image less new.png') }}" alt="Image d'accueil">
            </div>
        </div>
    </section>

    <section class="products-container">
            <h2>NOS PRODUITS</h2>
            <div class="product-grid">
                {% for product in products %}
                    <div class="product-card">
                        <div class="product-image">
                            <img src="{{ asset('/img/produits/' ~ product.picture) }}" alt="{{ product.name }}">
                        </div>
                        <div class="product-details">
                        <div>
                            <h3>{{ product.name }}</h3>
                            <p>{{ product.shortDescription }}</p>
                        </div>
                            <p class="price">{{ product.price }} €</p>
                            <p><a href="#">Voir le produit</a></p>
                        </div>
                    </div>
                {% endfor %}
            </div>
    </section>

    <section class="conviction-container">
        <div class="conviction-content">
            <div class="conviction-text">
                <h2>NOTRE CONVICTION</h2>
                <p>Chez GreenGoodies, nous croyons en un monde où le commerce peut être synonyme de bien-être pour la planète et ses habitants. Notre mission est de vous proposer une sélection rigoureuse de produits qui allient qualité, durabilité et éthique</  p>
            </div>
            <div class="conviction-empty"></div>
            <div class="conviction-image">
                <img src="{{ asset('/img/Image convinction.jpg') }}" alt="Image de conviction">
            </div>
        </div>  
    </section>

    <section class="values-container">
        <div class="values-content">
            <div class="values-image">
                <img src="{{ asset('/img/Image valeurs.jpg') }}" alt="Image de values">
            </div>
            <div class="values-empty"></div>
            <div class="values-text">
                <h2>NOS VALEURS</h2>
                <p>Durabilité : Nous sélectionnons soigneusement des produits qui respectent l'environnement et favorisent la durabilité.
Éthique : Nous nous engageons à travailler avec des partenaires et des fournisseurs qui partagent nos valeurs éthiques.
Écologie : Nous encourageons des pratiques respectueuses de l'écosystème et privilégions les matériaux écologiques.</p>
            </div>
        </div>  
    </section>

{% endblock %}
