{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<section class="panier-background">
    <div class="panier-container">

        <h1>Mon Panier</h1>

        {% if items is empty %}
            <p>Le panier est vide.</p>
        {% else %}
            <div class="panier-items">
                <a href="{{ path('app_panier_remove') }}" class="btn-supprimer">x Vider le panier</a>
                {% for item in items %}
                    <div class="panier-item">
                        <img src="{{ asset('/img/produits/' ~ item.productPicture )}}" alt="Image produit" class="item-picture">
                        <div class="item-details">
                            <p class="item-name">Produit: {{ item.productName }}</p>
                            <p class="item-quantity">Quantité: {{ item.quantity }}</p>
                            <p class="item-price">{{ item.unitPrice|number_format(2, ',', ' ') }} €</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="panier-total">
            <h2 class="total">Total panier: {{ total|number_format(2, ',', ' ') }}€</h2>
            <p class="btn-supprimer">Frais de livraison : Offert</p>
        </div>

        <a href="{{ path('app_panier_validation') }}" class="btn-valider">Valider la commande</a>

    </div>
</section>
{% endblock %}
