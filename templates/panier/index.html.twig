{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
    <section class="panier-container">
        <h1>Mon Panier</h1>
        <a href="{{ path('app_panier_remove') }}" class="btn-supprimer">Vider le panier</a>
        {% for item in items %}
                <img src="{{ asset('/img/produits/' ~ item.productPicture )}}" alt="Image produit" class="item-picture">
                <p class="item-name">Produit: {{ item.productName }}</p>
                <p class="item-quantity">Quantité: {{ item.quantity }}</p>
                <p class="item-price">Prix unitaire: {{ item.unitPrice }} €</p>
                <p class="item-subtotal">Sous-total: {{ item.quantity * item.unitPrice }} €</p>
        {% endfor %}

                <h2>Total: {{ total }} €</h2>

            <a href="{{ path('app_home') }}" class="btn-retour">Continuer mes achats</a>
    </section>
{% endblock %}
