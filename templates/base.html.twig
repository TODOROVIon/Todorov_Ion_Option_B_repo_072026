<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}GreenGoodies{% endblock %}</title>
        
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('/style/app.css') }}">
        {% endblock %}
        
    </head>
    <body>
          <header class="header">
                {% block header %}
                    <div class="container">
                        <div class="header-wrapper">
                            <div class="logo">
                                <a href="{{ path('app_home') }}">
                                    <span class="logo-icon">G</span>
                                    <span class="logo-text">Green Goodies</span>
                                </a>
                            </div>

                            <nav class="nav-menu">
                                <ul>
                                    {% if app.user %}
                                        <li><a href="{{ path('app_home') }}">Nos produits</a></li>
                                        <li><a href="{{ path('app_panier') }}">Mon panier</a></li>
                                        <li><a href="{{ path('app_compte') }}">Mon compte</a></li>
                                        <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                                    {% else %}
                                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                                        <li><a href="{{ path('app_inscription') }}">Inscription</a></li>
                                    {% endif %}
                                </ul>
                            </nav>
                        </div>
                    </div>
                {% endblock %}
          </header>


        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="footer">
            <div class="container">
                <p>&copy; GreenGoodies - {{ "now"|date("Y") }}</p>
            </div>
        </footer>


        {% block javascripts %}
            <script src="{{ asset('js/app.js') }}"></script>
        {% endblock %}
    </body>
</html>
