{% extends 'base.html.twig' %}

{% block title %}Hello Compte{% endblock %}

{% block body %}
<section class="compte-background">
    <div class="compte-container">

        <h1>Mon compte</h1>

        <div class="compte-info">
            <h2>Mes commandes</h2>

            {% if orders is empty%}
                <p>Aucune commande trouvée.</p>
            {% else %}
                <table class="table">
                    <thead>
                        <tr>
                            <th>N</th>
                            <th>Date</th>
                            <th>Prix</th>
                        </tr>
                    </thead>
                    {% for order in orders %}
                        <tr>
                            <td>{{ order.id }}</td>
                            <td>{{ order.orderDate|date('d/m/Y') }}</td>
                            <td>{{ order.totalPrice|number_format(2, ',', ' ') }}€</td>
                        </tr>
                    {% endfor %}

                </table>    
            {% endif %}

        </div>

        <div class="compte-card">
            <h2>Mon accès API</h2>
            {% if user.apiAccess %}
                <a href="{{ path('app_active_api') }}" class="btn-valider">Desactiver mon accès API</a>
            {% else %}
                <a href="{{ path('app_active_api') }}" class="btn-valider">Activer mon accès API</a>
            {% endif %}
        </div>

        <div class="compte-card">
            <a href="{{ path('app_delete') }}" class="btn-valider">Supprimer mon compte</a>
        </div>
    </div>
</section>
{% endblock %}
