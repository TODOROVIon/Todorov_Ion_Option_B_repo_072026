{% extends 'base.html.twig' %}

{% block title %}Hello Compte{% endblock %}

{% block body %}

    {% if orders is empty%}
        <p>Aucune commande trouvée.</p>
    {% else %}
        {% for order in orders %}
            <p>Id: {{ order.id }}</p>
            <p>Commande: {{ order.orderDate|date('d/m/Y') }}</p>
            <p>Price: {{ order.totalPrice }}</p>
        {% endfor %}
    {% endif %}

    {% if user.apiAccess %}
        <a href="{{ path('app_active_api') }}">Desactiver mon accès API</a>
    {% else %}
        <a href="{{ path('app_active_api') }}">Activer mon accès API</a>
    {% endif %}

    <a href="{{ path('app_delete') }}">Supprimer mon compte</a>

{% endblock %}
